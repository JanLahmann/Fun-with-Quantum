---
import '../styles/global.css';
import FamilyFooter from '../components/FamilyFooter.astro';
import { OFFLINE } from '../data/offline';

interface Props {
  title: string;
  description: string;
  /** Unlisted pages (previews): keep them out of search engines. */
  noindex?: boolean;
  /** Page language (BCP-47); the site chrome stays English. */
  lang?: string;
  /** Other language versions of this page, for hreflang. */
  alternates?: { lang: string; href: string }[];
  /** Social share image (path under public/); defaults to the site card. */
  ogImage?: string;
}

const { title, description, noindex = false, lang = 'en', alternates = [], ogImage = '/og-card.png' } = Astro.props;
const nav = [
  { href: '/play/', label: 'Play' },
  { href: '/build/', label: 'Build' },
  { href: '/learn/', label: 'Learn' },
  { href: '/teachers/', label: 'Teachers' },
  { href: '/workshops/', label: 'Workshops' },
  { href: '/about/', label: 'About' },
];
const path = Astro.url.pathname;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* no canonical on noindex pages: the previews and the 404 page (served at any missing URL) */}
    {!noindex && <link rel="canonical" href={new URL(path, Astro.site)} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(a.href, Astro.site)} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={new URL(path, Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />
    {/* Umami analytics (cookieless, shared family property — filter by hostname); none offline */}
    {!OFFLINE && <script defer src="https://cloud.umami.is/script.js" data-website-id="97f347ac-e7ba-4be3-b26f-ab4b328bdbf2" data-domains="fun-with-quantum.org"></script>}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header>
      <div class="wrap nav">
        <a class="brand" href="/">
          <picture>
            <source srcset="/fwq-mark-dark.svg" media="(prefers-color-scheme: dark)" />
            <img src="/fwq-mark.svg" alt="" width="34" height="34" />
          </picture>
          <span>Fun with Quantum</span>
        </a>
        {nav.map((item) => (
          <a class="item" href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
        <a class="ext" href="https://github.com/JanLahmann/Fun-with-Quantum" target="_blank" rel="noopener">GitHub ↗</a>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer>
      <div class="wrap">
        <FamilyFooter />
        <div class="fineprint">
          <a href="https://github.com/JanLahmann/Fun-with-Quantum" target="_blank" rel="noopener">Source on GitHub</a>{' '}·{' '}<a href="/about/#privacy">Privacy</a>{' '}·{' '}<a href="https://quantego.biz" target="_blank" rel="noopener" data-umami-event="Portal: shop click" data-umami-event-host="quantego.biz">Shop</a>
        </div>
        <div class="fineprint disclaimer">
          Fun with Quantum is an independent educational project and is not affiliated with,
          endorsed by, or sponsored by IBM Corporation. IBM®, IBM Quantum®, Qiskit®, IBM Quantum
          System One and IBM Quantum System Two are trademarks of International Business Machines
          Corporation. The projects on this site create educational games and models inspired by
          IBM's quantum computing systems for teaching purposes. LEGO is a trademark of the LEGO Group,
          which does not sponsor, authorize or endorse this site. Raspberry Pi is a trademark of
          Raspberry Pi Ltd.
        </div>
      </div>
    </footer>
    {OFFLINE && (
      <script is:inline>
        // Offline (RasQberry Two): links to fun-with-quantum.org stay on this copy; every other
        // link to the web gets an "online" label. ?kiosk: back to the home page after 3 idle minutes.
        for (const a of document.querySelectorAll('a[href^="http"]')) {
          const url = new URL(a.href);
          if (url.hostname === 'fun-with-quantum.org') { a.href = url.pathname + url.hash; a.removeAttribute('target'); continue; }
          if (url.host === location.host) continue;
          if (!a.textContent.trim()) continue;   // an image link: its caption carries the label
          const tag = document.createElement('span');
          tag.className = 'online-tag';
          tag.textContent = 'online';
          tag.title = 'Needs the internet';
          a.append(' ', tag);
        }
        try {
          if (new URLSearchParams(location.search).has('kiosk')) sessionStorage.setItem('fwq-kiosk', '1');
          if (sessionStorage.getItem('fwq-kiosk') === '1') {
            let timer;
            const home = () => { if (location.pathname !== '/') location.href = '/'; else scrollTo(0, 0); };
            const reset = () => { clearTimeout(timer); timer = setTimeout(home, 180000); };
            for (const e of ['pointerdown', 'keydown', 'scroll', 'touchstart']) addEventListener(e, reset, { passive: true });
            reset();
          }
        } catch { /* storage blocked: no kiosk reset */ }
      </script>
    )}
  </body>
</html>
