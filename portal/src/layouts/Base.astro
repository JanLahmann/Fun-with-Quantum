---
import '../styles/global.css';
import FamilyFooter from '../components/FamilyFooter.astro';
import { NO_REMOTE, OFFLINE } from '../data/offline';

interface Props {
  title: string;
  description: string;
  /** Unlisted pages (previews): keep them out of search engines. */
  noindex?: boolean;
  /** Page language (BCP-47); the site chrome stays English. */
  lang?: string;
  /** Other language versions of this page, for hreflang. */
  alternates?: { lang: string; href: string }[];
  /** Social share image (path under public/); defaults to the site card. */
  ogImage?: string;
  /** schema.org structured data (JSON-LD) for search engines; left out on noindex pages. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, noindex = false, lang = 'en', alternates = [], ogImage = '/og-card.png', jsonLd } = Astro.props;
const nav = [
  { href: '/play/', label: 'Play' },
  { href: '/build/', label: 'Build' },
  { href: '/learn/', label: 'Learn' },
  { href: '/teachers/', label: 'Teachers' },
  { href: '/workshops/', label: 'Workshops' },
  { href: '/about/', label: 'About' },
];
const path = Astro.url.pathname;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* no canonical on noindex pages: the previews and the 404 page (served at any missing URL) */}
    {!noindex && <link rel="canonical" href={new URL(path, Astro.site)} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(a.href, Astro.site)} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={new URL(path, Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />
    {/* `<` escaped so no text in the data can end the script element */}
    {jsonLd && !noindex && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
    {/* Umami analytics (cookieless, shared family property — filter by hostname); none offline. The family's
        standard snippet (family/EVENTS.md): ?notrack / ?track, no automated browsers. Then: a click on an external
        link without an event of its own sends `Portal: outbound click` (host), or `Portal: app store click` for the
        app's TestFlight / App Store links; sent directly (Umami posts with keepalive), so the link never waits. */}
    {!NO_REMOTE && <script is:inline>(function(){try{var q=location.search;if(/[?&]notrack\b/.test(q))localStorage.setItem('umami.disabled','1');if(/[?&]track\b/.test(q))localStorage.removeItem('umami.disabled')}catch(e){}window.fwqUmamiBeforeSend=function(t,p){var n=navigator;return(n.webdriver||/HeadlessChrome|bot|crawl|spider|Lighthouse|PageSpeed/i.test(n.userAgent))?false:p}})();</script>}
    {!NO_REMOTE && <script is:inline>document.addEventListener('click',function(e){var a=e.target&&e.target.closest&&e.target.closest('a[href]');if(!a||a.hasAttribute('data-umami-event'))return;var u;try{u=new URL(a.href,location.href)}catch(x){return}if(!/^https?:$/.test(u.protocol)||u.hostname===location.hostname)return;var h=u.hostname.replace(/^www\./,''),app={'testflight.apple.com':'testflight','apps.apple.com':'app-store'}[h];try{window.umami&&window.umami.track(app?'Portal: app store click':'Portal: outbound click',app?{target:app}:{host:h})}catch(x){}},true);</script>}
    {!NO_REMOTE && <script defer src="https://cloud.umami.is/script.js" data-website-id="97f347ac-e7ba-4be3-b26f-ab4b328bdbf2" data-domains="fun-with-quantum.org" data-before-send="fwqUmamiBeforeSend"></script>}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header>
      <div class="wrap nav">
        <a class="brand" href="/">
          <picture>
            <source srcset="/fwq-mark-dark.svg" media="(prefers-color-scheme: dark)" />
            <img src="/fwq-mark.svg" alt="" width="34" height="34" />
          </picture>
          <span>Fun with Quantum</span>
        </a>
        {nav.map((item) => (
          <a class="item" href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
        <a class="ext" href="https://github.com/JanLahmann/Fun-with-Quantum" target="_blank" rel="noopener">GitHub ↗</a>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer>
      <div class="wrap">
        <FamilyFooter />
        <div class="fineprint">
          <a href="https://github.com/JanLahmann/Fun-with-Quantum" target="_blank" rel="noopener">Source on GitHub</a>{' '}·{' '}<a href="/about/#privacy">Privacy</a>{' '}·{' '}<a href="https://quantego.biz" target="_blank" rel="noopener" data-umami-event="Portal: shop click" data-umami-event-host="quantego.biz">Shop</a>
        </div>
        <div class="fineprint disclaimer">
          Fun with Quantum is an independent educational project and is not affiliated with,
          endorsed by, or sponsored by IBM Corporation. IBM®, IBM Quantum®, Qiskit®, IBM Quantum
          System One and IBM Quantum System Two are trademarks of International Business Machines
          Corporation. The projects on this site create educational games and models inspired by
          IBM's quantum computing systems for teaching purposes. LEGO is a trademark of the LEGO Group,
          which does not sponsor, authorize or endorse this site. Raspberry Pi is a trademark of
          Raspberry Pi Ltd.
        </div>
      </div>
    </footer>
    {OFFLINE && (
      <script is:inline>
        // Offline (RasQberry Two): links to fun-with-quantum.org stay on this copy; every other
        // link to the web gets an "online" label. ?kiosk: back to the home page after 3 idle minutes.
        for (const a of document.querySelectorAll('a[href^="http"]')) {
          const url = new URL(a.href);
          if (url.hostname === 'fun-with-quantum.org') { a.href = url.pathname + url.hash; a.removeAttribute('target'); continue; }
          if (url.host === location.host) continue;
          if (!a.textContent.trim()) continue;   // an image link: its caption carries the label
          const tag = document.createElement('span');
          tag.className = 'online-tag';
          tag.textContent = 'online';
          tag.title = 'Needs the internet';
          a.append(' ', tag);
        }
        try {
          if (new URLSearchParams(location.search).has('kiosk')) sessionStorage.setItem('fwq-kiosk', '1');
          if (sessionStorage.getItem('fwq-kiosk') === '1') {
            let timer;
            const home = () => { if (location.pathname !== '/') location.href = '/'; else scrollTo(0, 0); };
            const reset = () => { clearTimeout(timer); timer = setTimeout(home, 180000); };
            for (const e of ['pointerdown', 'keydown', 'scroll', 'touchstart']) addEventListener(e, reset, { passive: true });
            reset();
          }
        } catch { /* storage blocked: no kiosk reset */ }
      </script>
    )}
  </body>
</html>
