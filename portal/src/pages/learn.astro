---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.door === 'learn')
  .sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Learn — quantum computing hands-on | Fun with Quantum"
  description="Learn quantum computing hands-on: executable Qiskit tutorials on doQumentation, certification prep on CertiQ, zero-setup Qiskit environments on QuBins, and IBM Quantum Learning."
>
  <section class="section">
    <div class="wrap">
      <div class="kicker">Learn</div>
      <h2>From first qubit to your own experiments</h2>
      <p class="lead">
        Run real Qiskit code in your browser with doQumentation, get exam-ready with CertiQ, keep
        coding in QuBins' ready-made environments — and IBM Quantum Learning for the official
        courses, made by the people who build the machines.
      </p>

      {projects.map((p) => <ProjectRow project={p} />)}

    </div>
  </section>
</Base>

