---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.door === 'learn')
  .sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Learn — quantum computing hands-on | Fun with Quantum"
  description="Learn quantum computing hands-on: IBM Quantum Learning, zero-setup Qiskit environments on QuBins, certification prep on CertiQ, executable Qiskit tutorials on doQumentation, and the QAMPoser circuit composer and library."
>
  <section class="section">
    <div class="wrap">
      <div class="kicker">Learn</div>
      <h2>From first qubit to your own experiments</h2>
      <p class="lead">
        Start with IBM Quantum Learning's official courses, made by the people who build the
        machines. Then keep coding in QuBins' ready-made environments, get exam-ready with CertiQ,
        run real Qiskit code in your browser with doQumentation — and build circuits, or your
        own quantum games and lessons, with QAMPoser.
      </p>

      {projects.map((p) => <ProjectRow project={p} />)}

    </div>
  </section>
</Base>

