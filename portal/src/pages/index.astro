---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Highlights from '../components/Highlights.astro';
import heroPhoto from '../assets/RasQberry2model.png';
import qoffeeMug from '../assets/qoffee-mug.png';
import quantegoPhoto from '../assets/quantego-two-photo.jpg';
import ibmLearning from '../assets/ibm-quantum-learning.png';
import qutieHero from '../assets/qutie-hero.jpg';
import certiqSite from '../assets/certiq-site.jpg';
import quantumCoin from '../assets/quantum-coin.png';
import qubinsSite from '../assets/qubins-site.png';

const games = (await getCollection('games')).sort((a, b) => a.data.order - b.data.order);
const featured = games.find((g) => g.data.featured) ?? games[0];
const allProjects = await getCollection('projects');
const qutie = allProjects.find((p) => p.id === 'qutie');
if (!qutie) throw new Error('projects/qutie.md missing — the homepage Build example needs it');
// Door links list the projects in the same order as the door's own page (by `order`).
const doorLinks = (door: string) =>
  allProjects
    .filter((p) => p.data.door === door && p.data.url)
    .sort((a, b) => a.data.order - b.data.order)
    .map((p) => ({ label: p.data.title, href: p.data.url! }));

const doors = [
  {
    key: 'play',
    href: '/play/',
    img: qoffeeMug,
    imgAlt: 'The Qoffee-Maker mug with a quantum circuit printed on it',
    fit: 'contain',
    title: 'Play',
    text: 'Build circuits with your hands, order coffee with a circuit, steer a runner with quantum gates — and try to beat a quantum computer at coin flipping.',
    links: [...doorLinks('play'), { label: `${games.length} notebook games`, href: '/play/' }],
  },
  {
    key: 'build',
    href: '/build/',
    img: quantegoPhoto,
    imgAlt: 'Quantego — a LEGO model of an IBM Quantum computer, mid-build',
    fit: 'cover',
    title: 'Build',
    text: '3D-print or LEGO-build your own model of an IBM Quantum computer.',
    links: doorLinks('build'),
  },
  {
    key: 'learn',
    href: '/learn/',
    img: ibmLearning,
    imgAlt: 'The IBM Quantum Learning platform: “Learn quantum computing” with a library of courses',
    fit: 'left',
    title: 'Learn',
    text: 'Take the official courses, keep coding in ready-made environments, prepare for the Qiskit certification, run real Qiskit code in your browser — and build your own quantum games.',
    links: doorLinks('learn'),
  },
];
---

<Base
  title="Fun with Quantum — quantum computing to play, build & learn"
  description="Quantum games, 3D-printed and LEGO quantum computer models, and hands-on ways to learn. Open source, nothing to install."
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1>Quantum computing you can <span class="hl-play">play</span>, <span class="hl-build">build</span> &amp; <span class="hl-learn">learn</span> — nothing to install.</h1>
        <p>
          Quantum games, LEGO and 3D-printed quantum computer models, and hands-on ways to learn.
          Open source, workshop-tested, built by the RasQberry community.
        </p>
        <Highlights />
      </div>
      <figure class="hero-photo">
        <a href="https://rasqberry.org" target="_blank" rel="noopener">
          <Image src={heroPhoto} alt="RasQberry Two — a 3D-printed model of IBM Quantum System Two with glowing LEDs" widths={[480, 760]} sizes="(max-width: 820px) 90vw, 520px" />
        </a>
        <figcaption><a href="https://rasqberry.org" target="_blank" rel="noopener">RasQberry Two ↗</a> — 3D-printed at home, Qiskit inside</figcaption>
      </figure>
    </div>
  </section>

  <section class="section" id="doors">
    <div class="wrap">
      <div class="kicker">Three ways in</div>
      <div class="grid cols-3">
        {doors.map((d) => (
          <div class={`card door door-${d.key}`}>
            <div class={`thumb ${d.fit}`}>
              <Image src={d.img} alt={d.imgAlt} widths={[480, 760]} sizes="(max-width: 820px) 90vw, 340px" />
            </div>
            <h3><a href={d.href}>{d.title} <span class="arrow">→</span></a></h3>
            <p>{d.text}</p>
            <span class="meta">
              {d.links.map((l, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={l.href} {...(l.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}</a>
                </>
              ))}
            </span>
          </div>
        ))}
      </div>

      <div class="kicker examples-kicker">Examples from each — no install, no account</div>
      <div class="grid cols-3 feature-grid">
        <div class="card door feature">
          <span class="badge cat-play">play · right here</span>
          <h3><a href={featured.data.webGame ? `/play/${featured.id}/#coin-game` : featured.data.binderUrl} {...(featured.data.webGame ? {} : { target: '_blank', rel: 'noopener' })}>{featured.data.icon} {featured.data.title} <span class="arrow">→</span></a></h3>
          <p>A gentle first look at superposition and interference — play it right in your browser, no account needed.</p>
          <Image class="feature-photo contain" src={quantumCoin} alt="The quantum coin — a Qiskit-logo coin, rendered in 3D" widths={[300, 600]} sizes="(max-width: 820px) 60vw, 300px" />
          <span class="meta">
            {featured.data.webGame
              ? <>plays instantly · then{' '}<a href={featured.data.binderUrl} target="_blank" rel="noopener">the Qiskit notebook ↗</a></>
              : <>Jupyter notebook · starting it can take a few minutes ·{' '}<a href={`/play/${featured.id}/`}>about the game</a></>}
          </span>
        </div>

        <div class="card door feature">
          <span class="badge cat-build">build</span>
          <h3><a href={qutie.data.url} target="_blank" rel="noopener">{qutie.data.icon} {qutie.data.title} <span class="arrow">→</span></a></h3>
          <p>{qutie.data.tagline} No electronics, no assembly — quantum for your desk.</p>
          <Image class="feature-photo" src={qutieHero} alt="Qutie One and Qutie Two — palm-sized 3D-printed quantum computer models" widths={[480, 760]} sizes="(max-width: 820px) 90vw, 340px" />
          <span class="meta">
            models &amp; print instructions at{' '}<a href={qutie.data.url} target="_blank" rel="noopener">qutie.org ↗</a>
          </span>
        </div>

        <div class="card door feature">
          <span class="badge cat-learn">learn</span>
          <h3><a href="https://certiq.dev" target="_blank" rel="noopener">🎓 CertiQ <span class="arrow">→</span></a></h3>
          <p>Get ready for the IBM Qiskit developer certification — guided path, drills, and a 68-question mock exam. Every question with code is checked by running it.</p>
          <Image class="feature-photo top" src={certiqSite} alt="certiq.dev — Pass the Qiskit v2.x Developer certification" widths={[480, 760]} sizes="(max-width: 820px) 90vw, 340px" />
          <span class="meta">
            free · no account · works offline ·{' '}<a href="https://certiq.dev" target="_blank" rel="noopener">certiq.dev ↗</a>
          </span>
        </div>
      </div>

      <div class="grid cols-3 try-grid">
        <div class="card">
          <span class="badge cat-play">play</span>
          <h3>Play Quantum Runner</h3>
          <p>Steer the runner with quantum gates — an H gate puts you in both lanes at once.</p>
          <a class="runner-link" href="https://qamposer.org/quantum-runner/" target="_blank" rel="noopener" title="Play Quantum Runner">
            <video
              class="runner-video"
              src="/quantum-runner.mp4"
              autoplay
              muted
              loop
              playsinline
              aria-label="Quantum Runner gameplay: building a circuit steers the runner across lanes"
            ></video>
          </a>
          <span class="meta">
            built on QAMPoser ·{' '}<a href="https://qamposer.org/quantum-runner/" target="_blank" rel="noopener">play it live ↗</a>
          </span>
        </div>

        <div class="card">
          <span class="badge cat-build">build</span>
          <h3>Spin the model</h3>
          <p>Quantego Two, a LEGO model of IBM Quantum System Two — drag to spin it in 3D.</p>
          <div class="model-wrap">
            <model-viewer
              src="https://quantego.org/assets/models/quantego-two.glb"
              alt="Interactive 3D model of Quantego Two, a LEGO IBM Quantum computer"
              camera-controls
              auto-rotate
              auto-rotate-delay="0"
              rotation-per-second="8deg"
              interaction-prompt="none"
              loading="lazy"
              touch-action="pan-y"
            ></model-viewer>
            <span class="spin-hint">↻ drag to spin</span>
          </div>
          <span class="meta">
            all three models at{' '}<a href="https://quantego.org" target="_blank" rel="noopener">quantego.org ↗</a>
          </span>
        </div>

        <div class="card">
          <span class="badge cat-learn">learn · right here</span>
          <h3>Launch a notebook from GitHub</h3>
          <p>Paste a link to a GitHub repository or notebook and run it in one click — <strong>Qiskit comes preinstalled</strong>.</p>
          <Image class="feature-photo top" src={qubinsSite} alt="qubins.org — prebuilt Qiskit environments with a one-click browser launch" widths={[480, 760]} sizes="(max-width: 820px) 90vw, 340px" />
          <form class="launch-form" id="launch-form">
            <input
              id="launch-input"
              type="text"
              value="github.com/JanLahmann/Fun-with-Quantum/blob/master/Quantum-Coin-Game.ipynb"
              placeholder="github.com/you/your-notebook"
              aria-label="GitHub repository or notebook URL"
              autocomplete="off"
              spellcheck="false"
            />
            <button class="btn primary" type="submit">Launch ▸</button>
          </form>
          <div class="launch-hint" id="launch-hint" hidden>Use a github.com link to a repository or a notebook.</div>
          <p class="launch-example">
            or one click:{' '}<a href="https://qubins.org/launch/?image=latest-xl&file=https://raw.githubusercontent.com/Qiskit/documentation/main/learning/courses/use-a-qc-today/build-and-run-your-first-quantum-program.ipynb" target="_blank" rel="noopener"
               data-umami-event="Portal: notebook launch" data-umami-event-target="qubins" data-umami-event-image="latest-xl"
               data-umami-event-notebook="use-a-qc-today/build-and-run-your-first-quantum-program.ipynb">▸ Build and run your first quantum program</a>{' '}
            <span class="launch-src">— from IBM's <em>Use a Quantum Computer Today</em> course</span>
          </p>
          <span class="meta">
            powered by the{' '}<a href="https://qubins.org" target="_blank" rel="noopener">QuBins launch-link generator ↗</a>
          </span>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="about">
    <div class="wrap">
      <div class="kicker">About</div>
      <h2>One family, one idea: quantum computing is more fun hands-on</h2>
      <div class="prose">
        <p>
          <em>Fun with Quantum</em> is the front door to a family of open-source quantum outreach
          projects that grew over years of talks, workshops, and conference booths: quantum{' '}<a href="/play/">games</a>{' '}you play in the browser, quantum computer models you{' '}<a href="/build/">3D-print or build from LEGO</a>, and hands-on ways to{' '}<a href="/learn/">learn and teach</a>. Everything is open source and tested on real audiences, from school classes to IEEE
          conferences, and most of it runs without accounts or installs.
        </p>
        <p>
          The family is built by <a href="https://www.linkedin.com/in/JanLahmann" target="_blank" rel="noopener">Jan-R.
          Lahmann</a> and the RasQberry community. Contributions are welcome in every repository —
          start at <a href="https://github.com/JanLahmann" target="_blank" rel="noopener">github.com/JanLahmann</a>.
        </p>
        <div class="callout">
          <p><strong>Running a workshop or event?</strong> We help you prepare it, free, as part of our open-source community work.</p>
          <a class="btn primary" href="/workshops/" data-umami-event="Portal: workshops open">Workshops &amp; events ▸</a>
        </div>
      </div>
    </div>
  </section>

  <div class="tagline-strip">
    <b>GOD DOES PLAY DICE.</b> COME PLAY, BUILD, LEARN.
  </div>

  <div class="trust wrap">
    <span>100% open source</span>
    <span>no accounts, no cookies</span>
    <span>Qiskit ecosystem</span>
    <span>workshop-ready</span>
    <span>from the makers of RasQberry</span>
  </div>
</Base>

<script is:inline type="module" src="https://cdn.jsdelivr.net/npm/@google/model-viewer@3.5.0/dist/model-viewer.min.js"></script>

<script>
  const form = document.getElementById('launch-form') as HTMLFormElement | null;
  const input = document.getElementById('launch-input') as HTMLInputElement | null;
  const hint = document.getElementById('launch-hint');

  function buildLaunchUrl(raw: string): string | null {
    let s = raw.trim().replace(/^https?:\/\//, '').replace(/^www\./, '');
    if (!s) return null;
    let owner: string, repo: string, branch = '', path = '';
    const gh = s.match(/^github\.com\/([^/]+)\/([^/]+?)(?:\.git)?(?:\/(?:blob|tree)\/([^/]+)\/(.+?))?\/?$/);
    if (gh) {
      owner = gh[1];
      repo = gh[2];
      branch = gh[3] || '';
      path = gh[4] || '';
    } else {
      const short = s.match(/^([\w.-]+)\/([\w.-]+)\/?$/);
      if (!short) return null;
      owner = short[1];
      repo = short[2];
    }
    // The FwQ slideshow games need the classic-RISE flavor to auto-start as a
    // presentation (jupyterlab-rise can't render ipywidgets>=8); everything
    // else gets the plain Lab image.
    const RISE_GAMES = /^(Quantum-Coin-Game|GHZ-Game|Hardys-Paradox|3sat|Mermin-Peres-Game|CHSH-Game|Prisoners-Dilemma)\.ipynb$/;
    const isRiseGame = owner === 'JanLahmann' && repo === 'Fun-with-Quantum' && RISE_GAMES.test(path);
    const q = new URLSearchParams({ image: isRiseGame ? '2.1-xl-rise' : '2.1-xl', repo: `https://github.com/${owner}/${repo}` });
    if (branch) q.set('branch', branch);
    if (path) q.set('path', path);
    if (isRiseGame) q.set('ui', 'rise-classic');
    return `https://qubins.org/launch/?${q.toString()}`;
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const url = buildLaunchUrl(input?.value ?? '');
    if (url) {
      hint?.setAttribute('hidden', '');
      window.open(url, '_blank', 'noopener');
    } else {
      hint?.removeAttribute('hidden');
    }
  });
</script>

<style>
  .callout {
    margin: 1.5em 0 0;
    padding: 18px 22px;
    background: var(--card);
    border: 1px solid var(--line);
    border-left: 4px solid var(--cyan);
    border-radius: 14px;
    box-shadow: var(--shadow);
  }
  .callout p { margin: 0 0 12px; }
  .hero { padding: 56px 0 24px; }
  .hero-grid {
    display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 48px; align-items: center;
  }
  @media (max-width: 820px) { .hero-grid { grid-template-columns: 1fr; } }
  .hero h1 { font-size: 2.5rem; margin-bottom: 18px; }
  @media (max-width: 820px) { .hero h1 { font-size: 1.9rem; } }
  .hero h1 .hl-play { color: var(--cyan); }
  .hero h1 .hl-build {
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero h1 .hl-learn { color: var(--magenta); }
  .hero-copy p { color: var(--muted); max-width: 520px; }
  .hero-photo > a { display: block; }
  .hero-photo img {
    border-radius: 16px; box-shadow: var(--shadow); width: 100%; height: auto;
    transition: outline-color 0.12s ease; outline: 2px solid transparent;
  }
  .hero-photo a:hover img { outline-color: var(--cyan); }
  .hero-photo figcaption {
    margin-top: 10px; font-size: 0.8rem; color: var(--muted); text-align: center;
  }
  .card.door h3 { font-size: 1.35rem; }

  /* category colors: tie each column to its door (same hues as the hero) */
  .door-build .arrow {
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .door-learn .arrow { color: var(--magenta); }
  .badge.cat-play { border-color: var(--cyan); color: var(--cyan); }
  .badge.cat-build {
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .badge.cat-learn { border-color: var(--magenta); color: var(--magenta); }

  /* rows 2+3: examples from the categories above */
  .examples-kicker { margin: 36px 0 14px; color: var(--muted); }
  .feature-grid { margin-top: 0; }
  .card.feature h3 { font-size: 1.08rem; }
  .card.feature .badge { margin-bottom: 2px; }
  .feature-photo {
    width: 100%; height: 150px; object-fit: cover;
    border: 1px solid var(--line); border-radius: 10px;
  }
  .feature-photo.contain { object-fit: contain; border: 0; background: transparent; }
  .feature-photo.top { object-position: top; }
  .try-grid { margin-top: 20px; }
  .try-grid .card h3 { font-size: 1.12rem; }
  .try-grid .badge { margin-bottom: 2px; }
  .runner-link { display: block; }
  .runner-link:hover .runner-video { border-color: var(--cyan); }
  .runner-video {
    width: 100%; height: 175px; object-fit: cover; object-position: top;
    border: 1px solid var(--line); border-radius: 10px; background: #14151D;
    transition: border-color 0.12s ease;
  }
  .launch-form { display: flex; gap: 10px; }
  .launch-form input {
    flex: 1; min-width: 0;
    font-family: var(--mono); font-size: 0.8rem;
    padding: 10px 12px; border: 1px solid var(--line); border-radius: 9px;
    background: var(--paper); color: var(--ink);
  }
  .launch-form input:focus { outline: 2px solid var(--cyan); outline-offset: -1px; border-color: var(--cyan); }
  .launch-form .btn { padding: 9px 16px; font-size: 0.88rem; }
  .launch-hint { font-size: 0.78rem; color: var(--magenta); }
  .launch-example { font-size: 0.85rem; margin: 2px 0 0; }
  .launch-example a { font-weight: 600; }
  .launch-src { color: var(--muted); }
  .model-wrap { position: relative; }
  model-viewer {
    width: 100%; height: 175px;
    border: 1px solid var(--line); border-radius: 10px;
    background: #fff;
    --poster-color: #fff;
    cursor: grab;
  }
  .spin-hint {
    position: absolute; right: 10px; bottom: 8px;
    font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.05em;
    color: var(--muted); background: var(--card);
    border: 1px solid var(--line); border-radius: 20px; padding: 2px 9px;
    pointer-events: none;
  }
</style>
