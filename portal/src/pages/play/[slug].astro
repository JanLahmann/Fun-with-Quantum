---
import { getCollection, render } from 'astro:content';
import { APP, OFFLINE } from '../../data/offline';
import Base from '../../layouts/Base.astro';
import CoinGame from '../../components/CoinGame.astro';
import GhzGame from '../../components/GhzGame.astro';
import ChshGame from '../../components/ChshGame.astro';
import { LOCALES, MESSAGES, pagePath } from '../../lib/qcoin/i18n';
import { gameJsonLd } from '../../lib/seo';
import { LANG_NAME, TRANSLATED_GAMES, gamePath } from '../../lib/games/locale';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.map((game) => ({ params: { slug: game.id }, props: { game } }));
}

const { game } = Astro.props;
const { Content } = await render(game);
// "More games": the browser games first (the pages most visitors want), then the rest in list order
const others = (await getCollection('games'))
  .filter((g) => g.id !== game.id)
  .sort((a, b) => Number(b.data.webGame) - Number(a.data.webGame) || a.data.order - b.data.order)
  .slice(0, 3);
// Umami `launch` event properties (family taxonomy, see family/EVENTS.md)
const launchUrl = new URL(game.data.binderUrl);
const launchTarget = launchUrl.hostname.includes('qubins') ? 'qubins' : launchUrl.hostname.includes('mybinder') ? 'binder' : launchUrl.hostname;
const launchImage = launchUrl.searchParams.get('image') ?? 'binder';
// the browser version of a launched game (`webGame: true`); unlisted ones live under /preview/
const WEB_GAMES: Record<string, typeof CoinGame | typeof GhzGame | typeof ChshGame> = {
  'quantum-coin-game': CoinGame,
  'ghz-game': GhzGame,
  'chsh-game': ChshGame,
};
const WebGame = game.data.webGame ? WEB_GAMES[game.id] : undefined;
if (game.data.webGame && !WebGame) throw new Error(`${game.id}: webGame is set, but no browser game is registered in play/[slug].astro`);
// the coin game also exists in six more languages (src/pages/[lang]/play/quantum-coin-game.astro),
// some other browser games in German (src/pages/de/play/, TRANSLATED_GAMES)
const coin = game.id === 'quantum-coin-game';
const langs = coin
  ? LOCALES.map((l) => ({ lang: l, href: pagePath(l), name: MESSAGES[l].langName }))
  : (TRANSLATED_GAMES[game.id] ?? []).map((l) => ({ lang: l, href: gamePath(game.id, l), name: LANG_NAME[l] }));
const alternates = langs.length ? [...langs.map(({ lang, href }) => ({ lang, href })), { lang: 'x-default', href: coin ? pagePath('en') : gamePath(game.id, 'en') }] : [];
// the search snippet: the tagline plus how you play it (about 155 characters at most)
const description = `${game.data.tagline} ${game.data.webGame ? 'Play it free in your browser, then open the Qiskit notebook.' : 'Free Qiskit notebook, no account needed.'}`;
const jsonLd = gameJsonLd({ id: game.id, title: game.data.title, description, concept: game.data.concept, level: game.data.level, goals: game.data.goals, webGame: game.data.webGame });
const launchVia = launchTarget === 'qubins' ? 'mybinder.org (via QuBins)' : launchTarget === 'binder' ? 'mybinder.org' : launchUrl.hostname;
---

<Base
  title={`${game.data.title} | Fun with Quantum`}
  description={description}
  alternates={alternates}
  jsonLd={jsonLd}
  ogImage={`/og/${game.id}.png`}
>
  <section class="section">
    <div class="wrap">
      <div class="top">
        {!APP && <div class="kicker">Play · {game.data.concept}</div>}
        {langs.length > 0 && (
          <nav class="langs" aria-label="Language">
            {langs.map((l) => (
              <a href={l.href} hreflang={l.lang} lang={l.lang} aria-current={l.lang === 'en' ? 'page' : undefined}>{l.name}</a>
            ))}
          </nav>
        )}
      </div>
      {/* in the app the screen's title bar names the game already */}
      <h1 class:list={[{ 'sr-only': APP }]}>{game.data.icon} {game.data.title}</h1>
      <p class="lead">{game.data.tagline}</p>

      {WebGame && <WebGame />}

      {game.data.webGame && (
        <h3 class="notebook-title">The real Qiskit code</h3>
        <p class="notebook-lead">The same game as an interactive Jupyter notebook — the quantum circuit runs on Qiskit, and you can change it.</p>
      )}
      {OFFLINE ? (
      <div class="launch card">
        <div>
          On a <strong>RasQberry Two</strong>, the desktop icon <strong>Fun with Quantum</strong> opens the notebook games on
          this Pi — no internet needed. Here, the notebook is <code>{game.data.notebook}</code>.
        </div>
      </div>
      ) : (
      <div class="launch card">
        <div>
          <a class="btn primary" href={game.data.binderUrl} target="_blank" rel="noopener"
             data-umami-event="Portal: notebook launch" data-umami-event-target={launchTarget} data-umami-event-image={launchImage}
             data-umami-event-notebook={game.data.notebook}>▶ Open the notebook</a>
          <div class="hero-note">
            {game.data.duration} · {game.data.audience} · runs in your browser, no account<br />
            Opens a free Jupyter session on {launchVia} — starting it can take a few minutes
          </div>
        </div>
        {!APP && <div class="alt">
          Prefer it local? <code>git clone</code> the{' '}<a href="https://github.com/JanLahmann/Fun-with-Quantum" target="_blank" rel="noopener">repository</a>, create the conda environment from <code>environment.yml</code>, and open <code>{game.data.notebook}</code>.
        </div>}
      </div>
      )}

      <div class="prose">
        <Content />
      </div>

      {/* in the app the Play tab lists the games; some of these are notebook pages */}
      {!APP && (
        <>
        <h3 class="more-title">More games</h3>
        <div class="grid cols-3">
          {others.map((g) => (
            <a class="card" href={`/play/${g.id}/`}>
              <span class="icon">{g.data.icon}</span>
              <h3>{g.data.title}</h3>
              <span class="meta">{g.data.concept}</span>
            </a>
          ))}
        </div>
        </>
      )}
    </div>
  </section>
</Base>

<style>
  /* a solution in the page text (the coin game's), folded so it doesn't spoil the game above */
  .prose :global(details.spoiler) { margin: 4px 0 16px; }
  .prose :global(details.spoiler summary) { cursor: pointer; font: 600 0.95rem var(--sans); color: var(--cyan); padding: 12px 0; }
  .prose :global(details.spoiler[open] summary) { margin-bottom: 6px; }
  .top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .langs { display: flex; flex-wrap: wrap; gap: 4px 12px; font: 0.8rem var(--sans); }
  .langs a { color: var(--muted); }
  .langs a[aria-current='page'] { color: var(--ink); font-weight: 600; }
  @media (pointer: coarse) { .langs a { padding: 13px 0; margin: -13px 0; } } /* tap targets of 44px without a taller row */
  .launch {
    flex-direction: row; align-items: center; justify-content: space-between;
    gap: 24px; margin-bottom: 36px; flex-wrap: wrap;
  }
  .launch .alt { color: var(--muted); font-size: 0.88rem; max-width: 320px; }
  .hero-note {
    margin-top: 10px; font-family: var(--mono); font-size: 0.72rem;
    letter-spacing: 0.04em; color: var(--muted);
  }
  .more-title { margin: 40px 0 16px; }
  .notebook-title { margin: 8px 0 4px; }
  .notebook-lead { color: var(--muted); margin-bottom: 14px; max-width: 640px; }
</style>
