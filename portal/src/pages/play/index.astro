---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import qoffeePhoto from '../../assets/qoffee-event.jpg';
import entangiblePhoto from '../../assets/entangible-bell-on-mat.png';

const games = (await getCollection('games')).sort((a, b) => a.data.order - b.data.order);
const projects = await getCollection('projects');
const qoffee = projects.find((p) => p.id === 'qoffee-maker');
const entangible = projects.find((p) => p.id === 'entangible');
---

<Base
  title="Play — quantum games | Fun with Quantum"
  description="Quantum games you play in the browser: beat a quantum computer at coin flipping, win an impossible team game with entanglement, build circuits with your hands on Entangible, steer Quantum Runner with gates, and order your coffee with a quantum circuit."
>
  <section class="section">
    <div class="wrap">
      <div class="kicker">Play</div>
      <h2>Games where quantum mechanics is the trick</h2>
      <p class="lead">
        Nothing to install, no account — every game here runs in your browser. One of them
        brews your coffee.
      </p>

      {entangible && (
        <a class="feature card" href={entangible.data.url} target="_blank" rel="noopener">
          <Image src={entangiblePhoto} alt={entangible.data.imageAlt ?? ''} widths={[420, 800]} sizes="(max-width: 820px) 90vw, 420px" />
          <div>
            <h3>{entangible.data.icon} {entangible.data.title} ↗</h3>
            <p class="feature-tag">{entangible.data.tagline}</p>
            <p class="feature-text">
              Lay gate tiles on a board, and a camera turns them into a live quantum circuit —
              results on the big screen as you build. Play Quantum Golf, steer Quantum Runner, or let
              Quantina's probabilities pick a drink. Made for booths, classrooms and kitchen tables;
              print the kit or use the on-screen boards.
            </p>
            <span class="meta">entangible.org ↗{entangible.data.ecosystemUrl && <>{' '}<img class="eco" src="/qiskit-ecosystem.svg" alt="Entangible is listed in the official Qiskit ecosystem" title="Entangible is listed in the official Qiskit ecosystem" width="127" height="20" loading="lazy" /></>}</span>
          </div>
        </a>
      )}

      {qoffee && (
        <a class="feature card" href={qoffee.data.url} target="_blank" rel="noopener">
          <Image src={qoffeePhoto} alt="The Qoffee-Maker at a conference — a coffee machine wired to a quantum circuit composer" widths={[420, 800]} sizes="(max-width: 820px) 90vw, 420px" />
          <div>
            <h3>{qoffee.data.icon} {qoffee.data.title} ↗</h3>
            <p class="feature-tag">{qoffee.data.tagline}</p>
            <p class="feature-text">
              Build a quantum circuit whose measurement outcome decides which drink the machine
              brews. Put the qubits in superposition and let physics choose — a conference
              favorite, and the most caffeinated way ever devised to learn what a measurement is.
            </p>
            <span class="meta">qoffee-maker.org ↗</span>
          </div>
        </a>
      )}

      <a class="feature card" href="https://qamposer.org/quantum-runner/" target="_blank" rel="noopener">
        <video
          src="/quantum-runner.mp4"
          autoplay
          muted
          loop
          playsinline
          aria-label="Quantum Runner gameplay: building a circuit steers the runner across lanes"
        ></video>
        <div>
          <h3>🏃 Quantum Runner ↗</h3>
          <p class="feature-tag">Steer the runner with quantum gates — an H gate puts you in both lanes at once.</p>
          <p class="feature-text">
            A quantum-circuit puzzle game where the circuit is the controller: the state of your
            qubit decides which lane the runner takes, superposition lets you collect coins in
            both, and the simulation results are the game logic. Built on QAMPoser.
          </p>
          <span class="meta">qamposer.org/quantum-runner ↗ <img class="eco" src="/qiskit-ecosystem.svg" alt="QAMPoser, the composer it is built on, is listed in the official Qiskit ecosystem" title="QAMPoser, the composer it is built on, is listed in the official Qiskit ecosystem" width="127" height="20" loading="lazy" /></span>
        </div>
      </a>

      <h2 class="games-title">The notebook games</h2>
      <p class="lead">
        Each game is an interactive notebook — one click, a short cold start, no account.
        Play first, then open the curtain and see the circuit.
      </p>
      <div class="grid cols-2">
        {games.map((g) => (
          <a class="card" href={`/play/${g.id}/`}>
            <span class="icon">{g.data.icon}</span>
            <h3>{g.data.title}</h3>
            <p>{g.data.tagline}</p>
            <span class="meta">{g.data.concept} · {g.data.duration}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .feature {
    display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 28px; align-items: center;
    margin-bottom: 12px;
  }
  @media (max-width: 820px) { .feature { grid-template-columns: 1fr; } }
  .feature img, .feature video { border-radius: 12px; width: 100%; height: auto; }
  .feature video { background: #14151D; }
  .feature h3 { font-size: 1.35rem; margin-bottom: 6px; }
  .feature-tag { color: var(--muted); font-size: 0.93rem; margin-bottom: 10px; }
  .feature-text { font-size: 0.93rem; color: var(--muted); margin-bottom: 12px; }
  .games-title { margin-top: 48px; }
  .meta .eco { display: inline-block; vertical-align: middle; margin-left: 8px; width: 127px; height: 20px; border-radius: 0; }
</style>
