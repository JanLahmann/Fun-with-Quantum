---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectRow from '../../components/ProjectRow.astro';

const games = (await getCollection('games')).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects'))
  .filter((p) => p.data.door === 'play')
  .sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Play — quantum games | Fun with Quantum"
  description="Quantum games you play in the browser: beat a quantum computer at coin flipping, win an impossible team game with entanglement, build circuits with your hands on Entangible, steer Quantum Runner with gates, and order your coffee with a quantum circuit."
>
  <section class="section">
    <div class="wrap">
      <div class="kicker">Play</div>
      <h2>Games where quantum mechanics is the trick</h2>
      <p class="lead">
        Nothing to install, no account — every game here runs in your browser. One of them
        brews your coffee.
      </p>

      {projects.map((p) => <ProjectRow project={p} />)}

      <h2 class="games-title">The notebook games</h2>
      <p class="lead">
        Each game is an interactive Jupyter notebook — one click, no account. It opens a free
        session on mybinder.org, so starting it can take a few minutes. Play first, then open
        the curtain and see the circuit.
      </p>
      <div class="grid cols-2">
        {games.map((g) => (
          <a class="card" href={`/play/${g.id}/`}>
            <span class="icon">{g.data.icon}</span>
            <h3>{g.data.title}</h3>
            <p>{g.data.tagline}</p>
            <span class="meta">{g.data.concept} · {g.data.duration}{g.data.webGame && ' · ▶ plays right here'}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .games-title { margin-top: 48px; }
</style>
