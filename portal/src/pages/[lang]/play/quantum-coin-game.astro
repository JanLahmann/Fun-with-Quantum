---
/** The Quantum Coin Game in every non-English locale (/de/…, /ja/…, …); English: /play/quantum-coin-game/. */
import CoinGamePage from '../../../components/CoinGamePage.astro';
import { LOCALES, type Locale } from '../../../lib/qcoin/i18n';

export function getStaticPaths() {
  return LOCALES.filter((l) => l !== 'en').map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Locale };
---

<CoinGamePage locale={lang} />
