---
/**
 * An unlisted browser-game page (English): header, the game (slot), the notebook link and the
 * other browser games. noindex, linked only from the other preview pages. To launch see portal/README.md.
 */
import Base from '../layouts/Base.astro';
import BrowserGames from './BrowserGames.astro';
import { NOTEBOOK_DOWN, QUBINS_DOWN, notebookHref, notebookTarget, qubinsLaunch } from '../lib/notebook-launch';

interface Props {
  page: { title: string; description: string; kicker: string; heading: string; lead: string; notebook: string; notebookLink: string };
  icon: string;
  notebook: string;
  current: 'magic' | 'sat' | 'hardy' | 'pd';
}
const { page, icon, notebook, current } = Astro.props;
const launch = qubinsLaunch(notebook);
---

<Base title={page.title} description={page.description} noindex>
  <section class="section">
    <div class="wrap">
      <div class="kicker">{page.kicker}</div>
      <h1>{icon} {page.heading}</h1>
      <p class="lead">{page.lead}</p>
      <slot />
      <p class="lead">
        {page.notebook}{' '}
        <a href={notebookHref(launch, notebook)} target="_blank" rel="noopener" data-umami-event="Portal: notebook launch" data-umami-event-target={notebookTarget(launch)}
           data-umami-event-image="2.5-xl" data-umami-event-notebook={notebook}>{QUBINS_DOWN ? NOTEBOOK_DOWN.en.link : page.notebookLink}</a>
        <span class="wait">{QUBINS_DOWN ? NOTEBOOK_DOWN.en.note : 'It starts a free Jupyter session on mybinder.org (via QuBins); starting it can take a few minutes.'}</span>
      </p>
      <BrowserGames current={current} />
    </div>
  </section>
</Base>

<style>
  .wait { display: block; margin-top: 4px; font-size: 0.8rem; color: var(--muted); }
</style>
