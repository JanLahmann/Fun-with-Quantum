---
/**
 * An unlisted browser-game page (English): header, the game (slot), the notebook link and the
 * other browser games. noindex, linked only from the other preview pages. To launch see portal/README.md.
 */
import Base from '../layouts/Base.astro';
import BrowserGames from './BrowserGames.astro';

interface Props {
  page: { title: string; description: string; kicker: string; heading: string; lead: string; notebook: string; notebookLink: string };
  icon: string;
  notebook: string;
  current: 'ghz' | 'magic' | 'sat' | 'chsh' | 'hardy' | 'pd';
}
const { page, icon, notebook, current } = Astro.props;
const launch = `https://qubins.org/launch/?image=2.1-xl-rise&repo=https://github.com/JanLahmann/Fun-with-Quantum&branch=master&path=${notebook}&ui=rise-classic`;
---

<Base title={page.title} description={page.description} noindex>
  <section class="section">
    <div class="wrap">
      <div class="kicker">{page.kicker}</div>
      <h2>{icon} {page.heading}</h2>
      <p class="lead">{page.lead}</p>
      <slot />
      <p class="lead">
        {page.notebook}{' '}
        <a href={launch} target="_blank" rel="noopener" data-umami-event="Portal: notebook launch" data-umami-event-target="qubins"
           data-umami-event-image="2.1-xl-rise" data-umami-event-notebook={notebook}>{page.notebookLink}</a>
        <span class="wait">It starts a free Jupyter session on mybinder.org (via QuBins); starting it can take a few minutes.</span>
      </p>
      <BrowserGames current={current} />
    </div>
  </section>
</Base>

<style>
  .wait { display: block; margin-top: 4px; font-size: 0.8rem; color: var(--muted); }
</style>
