---
/**
 * Ket as the family guide (issue #153): a floating "Ask Ket" box that helps visitors pick the project
 * or game that fits them. On the home page, the three doors, /teachers/ and /workshops/ (the pages
 * in GUIDE_PAGES, assistant/src/contexts/fwq/guide.ts). Like AssistantChat: built only when
 * PUBLIC_FWQ_ASSISTANT_URL is set and never offline. Its own switch, apart from the game chats: shown to
 * everyone once PUBLIC_FWQ_GUIDE_PUBLIC=1 (repository variable FWQ_GUIDE_PUBLIC), until then only with
 * ?assistant=1 in the address.
 */
import { APP, OFFLINE } from '../data/offline';
import { ASSISTANT_TEXTS, GUIDE_TEXTS } from '../lib/assistant/i18n';

const url = import.meta.env.PUBLIC_FWQ_ASSISTANT_URL ?? '';
const isPublic = import.meta.env.PUBLIC_FWQ_GUIDE_PUBLIC === '1';
const t = { ...ASSISTANT_TEXTS.en, ...GUIDE_TEXTS };
---
{/* Not in the iOS app: it has the guide as a native sheet on its tabs. */}
{url && !OFFLINE && !APP && (
  <section class="fwq-assist fa-float" aria-label={t.title} data-url={url} data-site="fwq" data-context="guide" data-locale="en" data-public={isPublic ? '1' : undefined} hidden>
    <div class="fa-panel" id="fa-guide-panel" hidden>
      <h2 class="fa-h">{t.title}</h2>
      <p class="fa-intro">{t.intro}</p>
      <p class="fa-privacy">{t.privacy} <a href="/about/#privacy">{t.privacyLink}</a></p>
      <div class="fa-log" aria-live="polite"></div>
      <form>
        <label class="fa-sr" for="fa-guide-q">{t.placeholder}</label>
        <textarea id="fa-guide-q" rows="2" maxlength="1000" placeholder={t.placeholder}></textarea>
        <button type="submit">{t.send}</button>
      </form>
    </div>
    <button type="button" class="fa-open" aria-expanded="false" aria-controls="fa-guide-panel"><span aria-hidden="true">💬</span> {t.open}</button>
  </section>
)}

<script>
  import { GUIDE_TEXTS } from '../lib/assistant/i18n';
  import { registerState } from '../lib/assistant/state';
  import { mountAssistant } from '../lib/assistant/widget';
  const root = document.querySelector<HTMLElement>('.fwq-assist[data-context="guide"]');
  if (root && (root.dataset.public === '1' || new URLSearchParams(location.search).get('assistant') === '1')) {
    root.hidden = false;
    registerState('guide', () => ({ page: location.pathname }));
    mountAssistant(root, { texts: GUIDE_TEXTS });
    // Escape closes the box and gives the focus back to its button.
    const open = root.querySelector<HTMLButtonElement>('.fa-open')!;
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !root.querySelector<HTMLElement>('.fa-panel')!.hidden) { open.click(); open.focus(); }
    });
  }
</script>

<style>
  .fa-float {
    position: fixed; right: 16px; bottom: 16px; z-index: 50;
    display: flex; flex-direction: column; align-items: flex-end; gap: 10px;
  }
  .fa-float[hidden], .fa-panel[hidden] { display: none; }
  .fa-open {
    font: 600 0.92rem var(--sans); color: var(--card); background: var(--cyan); border: 0;
    border-radius: 22px; padding: 10px 18px; cursor: pointer; box-shadow: var(--shadow);
  }
  .fa-open:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .fa-panel {
    width: min(400px, calc(100vw - 32px)); max-height: calc(100vh - 90px); max-height: calc(100dvh - 90px); overflow: auto;
    background: var(--card); border: 1px solid var(--line); border-radius: 16px; box-shadow: var(--shadow);
    padding: 14px 16px 16px; box-sizing: border-box;
  }
  .fa-panel .fa-h { font-size: 1.02rem; margin: 0 0 4px; }
  .fa-intro { color: var(--ink); font-size: 0.9rem; margin-bottom: 6px; }
  .fa-privacy { color: var(--muted); font-size: 0.78rem; margin-bottom: 12px; }
  .fa-log { display: flex; flex-direction: column; gap: 10px; max-height: min(420px, calc(100vh - 340px)); max-height: min(420px, calc(100dvh - 340px)); min-height: 120px; overflow-y: auto; margin-bottom: 12px; }
  .fa-log:empty { display: none; }
  .fa-log :global(.fa-msg) { font-size: 0.93rem; line-height: 1.5; }
  .fa-log :global(.fa-who) { display: block; font: 600 0.7rem var(--mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); margin-bottom: 2px; }
  .fa-log :global(.fa-you .fa-body) { color: var(--ink); }
  .fa-log :global(.fa-bot .fa-body) { border-left: 3px solid var(--magenta); padding-left: 10px; }
  .fa-log :global(.fa-body p + p) { margin-top: 6px; }
  .fa-log :global(.fa-body a) { color: var(--cyan); word-break: break-all; }
  .fa-log :global(.fa-body code) { font: 0.85em var(--mono); background: var(--paper); border: 1px solid var(--line); border-radius: 4px; padding: 0 3px; }
  .fa-log :global(.fa-thinking) { color: var(--muted); font-style: italic; }
  .fa-log :global(.fa-error) { color: var(--magenta); }
  .fa-log :global(.fa-vote) { display: flex; gap: 6px; align-items: center; font-size: 0.8rem; color: var(--muted); padding-left: 13px; }
  .fa-log :global(.fa-vote button) { background: transparent; border: 1px solid var(--line); border-radius: 8px; padding: 2px 8px; cursor: pointer; font-size: 0.9rem; }
  .fa-log :global(.fa-vote button:hover) { border-color: var(--cyan); }
  form { display: flex; gap: 8px; align-items: flex-end; }
  textarea {
    flex: 1; font: 1rem var(--sans); /* 16px: iOS doesn't zoom in on focus */ color: var(--ink); background: var(--paper); border: 1px solid var(--line);
    border-radius: 10px; padding: 8px 10px; resize: vertical; min-height: 44px;
  }
  textarea:focus { outline: 2px solid var(--cyan); outline-offset: 1px; }
  button[type='submit'] {
    font: 600 0.9rem var(--sans); color: var(--card); background: var(--cyan); border: 0; border-radius: 10px; padding: 10px 16px; cursor: pointer;
  }
  button[type='submit']:disabled { opacity: 0.6; cursor: wait; }
  .fa-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 480px) { .fa-float { right: 10px; bottom: 10px; } .fa-panel { width: calc(100vw - 20px); } }
  @media print { .fa-float { display: none; } }
</style>
