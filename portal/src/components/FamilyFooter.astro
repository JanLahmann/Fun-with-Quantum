---
/**
 * The family footer block — rendered from the shared manifest, never hand-edited.
 * Each member shows its name and the manifest's `short` line (3–5 words).
 */
import { loadFamily, footerLinks, SELF_ID } from '../data/family-manifest';

const family = loadFamily();
const links = footerLinks(family, SELF_ID);
---

<div class="tag">{family.brand.tagline.l}</div>
<div class="family">
  <strong>{family.brand.footer_lead}</strong>
  {links.map((s) => (
    <a class="member" href={s.url} target="_blank" rel="noopener" data-umami-event="family-footer" data-umami-event-to={s.id}>
      <span>{s.name}</span>
      {s.short && <small>{s.short}</small>}
    </a>
  ))}
</div>
<div>
  Open source, built by <a href={family.brand.credit_url} target="_blank" rel="noopener">Jan-R. Lahmann</a> and the
  RasQberry community. No accounts, no cookies.
</div>
