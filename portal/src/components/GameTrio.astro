---
/**
 * "Three quantum games" strip linking the three browser games to each other. Used only on the
 * unlisted preview pages for now (English); when the games launch, point the links at /play/….
 */
interface Props {
  current: 'coin' | 'ghz' | 'magic';
}
const { current } = Astro.props;
const GAMES = [
  { id: 'coin', href: '/preview/coin-game/', icon: '🪙', title: 'Quantum Coin Game', concept: 'Superposition & interference' },
  { id: 'ghz', href: '/preview/ghz-game/', icon: '🔗', title: 'GHZ Game', concept: 'Entanglement' },
  { id: 'magic', href: '/preview/magic-square/', icon: '🎩', title: 'Magic Square', concept: 'Contextuality' },
] as const;
---

<nav class="trio" aria-label="Three quantum games">
  <h3>Three quantum games, right in your browser</h3>
  <div class="grid cols-3">
    {GAMES.map((g) => (
      <a class="card" href={g.href} aria-current={g.id === current ? 'page' : undefined}>
        <span class="icon">{g.icon}</span>
        <h3>{g.title}</h3>
        <span class="meta">{g.concept}{g.id === current && ' · you are here'}</span>
      </a>
    ))}
  </div>
</nav>

<style>
  .trio { margin: 8px 0 12px; }
  .trio > h3 { margin: 0 0 14px; }
  .trio a[aria-current='page'] { border-color: var(--magenta); }
</style>
