---
/**
 * The Quantum Coin Game, playable in the browser — no Binder, no install.
 * Logic in src/lib/qcoin (unit-tested), interaction in src/lib/qcoin/ui.ts.
 * The coin's 3D orientation is the qubit's Bloch vector: flat = heads/tails, on its edge = superposition.
 */
import { MESSAGES, type Locale } from '../lib/qcoin/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const m = MESSAGES[locale];
const RIM_SEGMENTS = 44;
---

<section class="qcoin" id="coin-game" aria-label={m.page.heading} data-locale={locale}>
  <div class="qc-top">
    <div class="qc-chapters" role="tablist" aria-label={m.ui.chaptersLabel}>
      {m.ui.chapters.map((label, i) => (
        <button role="tab" data-chapter={i + 1}><span class="n">{i + 1}</span> {label}</button>
      ))}
    </div>
    <button type="button" class="qc-explain-btn" aria-haspopup="dialog">ⓘ {m.ui.explain}</button>
  </div>

  <div class="qc-arena">
    <div class="qc-stage">
      <div class="qc-scene">
        <div class="qc-shadow"></div>
        <div class="qc-pos">
          <div class="qc-coin">
            <div class="qc-face qc-front"></div>
            <div class="qc-face qc-back"></div>
            {Array.from({ length: RIM_SEGMENTS }, (_, i) => (
              <div class="qc-rim" style={`--i:${i};--n:${RIM_SEGMENTS}`}></div>
            ))}
          </div>
        </div>
        <div class="qc-box" aria-hidden="true"><span>?</span><small>{m.ui.coinInBox}</small></div>
      </div>

      <div class="qc-readout">
        <div>
          <div class="qc-probs" aria-label={m.ui.probsLabel}>
            <div class="qc-prob"><span class="lbl">{m.ui.heads}</span><span class="bar"><i class="fill heads"></i></span><span class="pct" data-p="heads">100%</span></div>
            <div class="qc-prob"><span class="lbl">{m.ui.tails}</span><span class="bar"><i class="fill tails"></i></span><span class="pct" data-p="tails">0%</span></div>
            <button type="button" class="qc-info" data-term="measurement" aria-label={m.glossary.measurement.title}>ⓘ</button>
          </div>
          <div class="qc-state" aria-live="polite"></div>
          <p class="qc-gatefx" aria-live="polite"></p>
        </div>
        <figure class="qc-bloch" aria-label={m.ui.blochCaption}>
          <svg viewBox="0 0 150 150" role="img">
            <g class="sphere"></g>
            <g class="axisline"></g>
            <line class="vec" x1="75" y1="75" x2="75" y2="75"></line>
            <circle class="tip" cx="75" cy="75" r="4.5"></circle>
            <text class="hidden-q" x="75" y="82" text-anchor="middle">?</text>
          </svg>
          <figcaption><button type="button" class="qc-term qc-caption" data-term="bloch">{m.ui.blochCaption} ⓘ</button></figcaption>
        </figure>
      </div>
    </div>

    <div class="qc-panel">
      <h3 class="qc-title"></h3>
      <div class="qc-text"></div>
      <div class="qc-order" role="group" aria-label={m.ui.whoStarts} hidden>
        <span>{m.ui.whoStarts}</span>
        <button type="button" data-order="computer" aria-pressed="true">{m.ui.theComputer}</button>
        <button type="button" data-order="you" aria-pressed="false">{m.ui.you}</button>
      </div>
      <div class="qc-circuit" aria-label={m.ui.circuitLabel}></div>
      <p class="qc-status" aria-live="polite"></p>
      <div class="qc-actions"></div>
      <div class="qc-score" aria-live="polite"></div>
    </div>
  </div>
  <dialog class="qc-explain" aria-label={m.ui.explainTitle}>
    <button type="button" class="qc-close" aria-label={m.ui.close}>×</button>
    <div class="qc-explain-body"></div>
  </dialog>
  <noscript><p class="qc-noscript">{m.ui.noscript}</p></noscript>
</section>

<script>
  import { mountCoinGame } from '../lib/qcoin/ui';
  const root = document.getElementById('coin-game');
  if (root) mountCoinGame(root);
</script>

<style>
  .qcoin {
    --coin: 180px;
    --thick: 12px;
    background: var(--card); border: 1px solid var(--line); border-radius: 16px;
    box-shadow: var(--shadow); padding: 18px 22px 22px; margin-bottom: 36px;
  }
  .qc-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; margin-bottom: 14px; }
  .qc-chapters { display: flex; flex-wrap: wrap; gap: 6px; }
  .qc-explain-btn {
    flex: 0 0 auto; font: 600 0.82rem var(--sans); color: var(--cyan); background: transparent;
    border: 1px solid var(--cyan); border-radius: 20px; padding: 6px 12px; cursor: pointer;
  }
  .qc-explain-btn:hover { background: color-mix(in srgb, var(--cyan) 10%, transparent); }
  .qcoin :global(.qc-term) {
    font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: help;
    text-decoration: underline dotted color-mix(in srgb, var(--cyan) 70%, transparent); text-underline-offset: 3px;
  }
  .qcoin :global(.qc-term:hover) { color: var(--cyan); }
  .qc-info {
    position: absolute; right: -4px; top: -22px; width: 20px; height: 20px; border-radius: 50%;
    border: 0; background: transparent; color: var(--cyan); cursor: help; font-size: 0.9rem;
  }
  .qc-caption { font: 0.66rem var(--mono) !important; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted) !important; }
  .qc-explain {
    margin: auto; /* global.css resets * { margin: 0 }, which un-centres a modal dialog */
    max-width: min(520px, calc(100vw - 32px)); width: 100%; max-height: calc(100vh - 48px); overflow-y: auto; border: 1px solid var(--line); border-radius: 16px;
    background: var(--card); color: var(--ink); padding: 24px 26px 20px; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }
  .qc-explain::backdrop { background: rgba(20, 21, 29, 0.45); }
  .qc-close {
    position: absolute; top: 10px; right: 12px; width: 32px; height: 32px; border-radius: 50%;
    border: 1px solid var(--line); background: var(--card); color: var(--muted); font-size: 1.2rem; cursor: pointer;
  }
  .qc-close:hover { color: var(--ink); border-color: var(--cyan); }
  .qc-explain :global(h3) { font-size: 1.15rem; margin: 6px 36px 10px 0; }
  .qc-explain :global(p) { color: var(--ink); font-size: 0.97rem; margin-bottom: 12px; }
  .qc-explain :global(.qc-more) { font: 0.85rem var(--sans); line-height: 1.9; margin-bottom: 0; }
  .qc-explain :global(.qc-back) { font: 0.8rem var(--mono); color: var(--cyan); background: none; border: 0; cursor: pointer; padding: 0; }
  .qc-explain :global(.qc-terms) { list-style: none; columns: 2 200px; gap: 18px; padding: 0; }
  .qc-explain :global(.qc-terms li) { margin: 0 0 8px; break-inside: avoid; }
  .qc-explain :global(.qc-terms .qc-term) { text-align: left; }
  .qc-chapters button {
    font: 600 0.82rem var(--sans); color: var(--muted); background: transparent;
    border: 1px solid var(--line); border-radius: 20px; padding: 6px 12px; cursor: pointer;
  }
  .qc-chapters button .n {
    display: inline-grid; place-items: center; width: 18px; height: 18px; margin-right: 4px;
    border-radius: 50%; font: 600 0.7rem var(--mono); background: var(--line); color: var(--ink);
  }
  .qc-chapters button:hover { border-color: var(--cyan); color: var(--cyan); }
  .qc-chapters button[aria-selected='true'] { color: var(--ink); border-color: var(--magenta); }
  .qc-chapters button[aria-selected='true'] .n { background: var(--grad); color: #fff; }
  .qc-chapters button.done .n { background: color-mix(in srgb, var(--cyan) 22%, transparent); color: var(--cyan); }

  .qc-arena { display: grid; grid-template-columns: minmax(280px, 1fr) 1.15fr; gap: 26px; align-items: start; }
  @media (max-width: 860px) {
    .qc-arena { grid-template-columns: 1fr; gap: 14px; }
    /* on phones keep the moves right under the coin; the explanation follows */
    .qc-panel { display: flex; flex-direction: column; }
    .qc-title { order: 0; }
    .qc-order { order: 0; }
    .qc-circuit { order: 1; }
    .qc-status { order: 2; }
    .qc-actions { order: 3; }
    .qc-score { order: 4; }
    .qc-text { order: 5; margin-top: 12px; }
  }

  /* ---------- the 3D coin ---------- */
  .qc-stage { position: relative; }
  .qc-scene {
    position: relative; height: 300px; perspective: 900px; perspective-origin: 50% 35%;
    border-radius: 12px; overflow: hidden;
    background:
      radial-gradient(120% 70% at 50% 100%, color-mix(in srgb, var(--cyan) 10%, transparent), transparent 70%),
      linear-gradient(to bottom, transparent 62%, color-mix(in srgb, var(--ink) 5%, transparent) 62%);
  }
  .qc-shadow {
    position: absolute; left: 50%; top: 62%; width: calc(var(--coin) * 1.05); height: calc(var(--coin) * 0.32);
    transform: translate(-50%, -38%) scaleX(var(--shadow-x, 1)); border-radius: 50%;
    background: radial-gradient(closest-side, rgba(0, 0, 0, 0.32), transparent);
    opacity: var(--shadow-o, 1);
  }
  .qc-pos { position: absolute; left: 50%; top: 62%; width: 0; height: 0; transform-style: preserve-3d; }
  .qc-coin {
    position: absolute; width: var(--coin); height: var(--coin);
    left: calc(var(--coin) / -2); top: calc(var(--coin) / -2);
    transform-style: preserve-3d; will-change: transform;
  }
  .qc-face {
    position: absolute; inset: 0; border-radius: 50%; background-size: cover;
    backface-visibility: hidden; -webkit-backface-visibility: hidden;
    filter: brightness(var(--light, 1));
  }
  .qc-front { background-image: url('/coin/face-heads.webp'); transform: translateZ(calc(var(--thick) / 2)); }
  .qc-back { background-image: url('/coin/face-tails.webp'); transform: rotateY(180deg) translateZ(calc(var(--thick) / 2)); }
  .qc-rim {
    position: absolute; left: 50%; top: 50%;
    width: calc(3.1416 * var(--coin) / var(--n) + 1.2px); height: var(--thick);
    margin-left: calc((3.1416 * var(--coin) / var(--n) + 1.2px) / -2); margin-top: calc(var(--thick) / -2);
    transform: rotateZ(calc(360deg / var(--n) * var(--i))) translateY(calc(var(--coin) / -2)) rotateX(90deg);
    background: linear-gradient(to right, #8d9097, #d9dbe0 45%, #a4a7ae);
    filter: brightness(calc(0.7 + 0.35 * var(--light, 1)));
  }

  .qc-box {
    position: absolute; left: 50%; top: 9%; width: 236px; height: 218px; margin-left: -118px;
    border-radius: 22px 22px 10px 10px; background: var(--grad);
    box-shadow: 0 18px 30px rgba(0, 0, 0, 0.28), inset 0 -10px 0 rgba(0, 0, 0, 0.12);
    display: grid; place-items: center; align-content: center; gap: 2px; color: #fff;
    transform: translateY(-125%) scale(0.96); opacity: 0; pointer-events: none;
    transition: transform 0.55s cubic-bezier(.2,.8,.2,1), opacity 0.35s ease;
  }
  .qc-box span { font: 700 4.4rem/1 var(--sans); opacity: 0.92; }
  .qc-box small { font: 0.7rem var(--mono); letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.85; }
  .qcoin.covered .qc-box { transform: none; opacity: 1; }
  .qcoin.shake .qc-box { animation: qc-shake 0.5s ease; }
  @keyframes qc-shake {
    0%, 100% { transform: none; }
    20% { transform: translateX(-7px) rotate(-2deg); }
    40% { transform: translateX(6px) rotate(2deg); }
    60% { transform: translateX(-4px) rotate(-1deg); }
    80% { transform: translateX(3px); }
  }

  .qc-readout { display: grid; grid-template-columns: 1fr 132px; gap: 12px; align-items: center; margin-top: 10px; }
  .qc-probs { display: grid; gap: 6px; position: relative; }
  .qc-bloch { margin: 0; text-align: center; }
  .qc-bloch svg { width: 132px; height: 132px; display: block; overflow: visible; }
  .qc-bloch figcaption { font: 0.66rem var(--mono); color: var(--muted); letter-spacing: 0.08em; text-transform: uppercase; margin-top: -4px; }
  .qc-bloch :global(.outline) { fill: color-mix(in srgb, var(--cyan) 6%, transparent); stroke: var(--muted); stroke-width: 1; opacity: 0.7; }
  .qc-bloch :global(.ring) { fill: none; stroke: var(--muted); stroke-width: 0.8; opacity: 0.55; }
  .qc-bloch :global(.ring.back) { stroke-dasharray: 2 3; opacity: 0.35; }
  .qc-bloch :global(.axis) { stroke: var(--muted); stroke-width: 0.6; opacity: 0.35; }
  .qc-bloch :global(.lbl) { font: 9px var(--mono); fill: var(--muted); }
  .qc-bloch :global(.rotaxis) { stroke: var(--cyan); stroke-width: 1.6; stroke-dasharray: 4 3; }
  .qc-gatefx { margin-top: 6px; min-height: 2.6em; font-size: 0.82rem; line-height: 1.4; color: var(--muted); }
  .qc-gatefx :global(b) { color: var(--ink); }
  .qcoin.covered .qc-gatefx { visibility: hidden; }
  .qc-bloch .vec { stroke: var(--magenta); stroke-width: 3; stroke-linecap: round; }
  .qc-bloch .tip { fill: var(--magenta); }
  .qc-bloch .hidden-q { font: 700 22px var(--sans); fill: var(--muted); opacity: 0; }
  .qc-bloch :global(.behind) { opacity: 0.45; }
  .qcoin.covered .qc-bloch .vec, .qcoin.covered .qc-bloch .tip { opacity: 0; }
  .qcoin.covered .qc-bloch .hidden-q { opacity: 0.8; }
  .qc-prob { display: grid; grid-template-columns: 52px 1fr 48px; align-items: center; gap: 8px; font: 0.8rem var(--mono); color: var(--muted); }
  .qc-prob .bar { height: 10px; border-radius: 6px; background: var(--line); overflow: hidden; }
  .qc-prob .fill { display: block; height: 100%; width: 0; transition: width 0.45s ease; }
  .qc-prob .fill.heads { background: var(--cyan); }
  .qc-prob .fill.tails { background: var(--magenta); }
  .qc-prob .pct { text-align: right; color: var(--ink); }
  .qcoin.covered .qc-prob .fill { width: 0 !important; }
  .qc-state { margin-top: 8px; min-height: 1.4em; font: 0.85rem var(--mono); color: var(--muted); text-align: center; }

  /* ---------- panel ---------- */
  .qc-title { font-size: 1.2rem; margin-bottom: 6px; }
  .qc-text :global(p) { color: var(--muted); font-size: 0.97rem; margin-bottom: 8px; }
  .qc-text :global(.math) { font-family: var(--mono); font-size: 0.85rem; color: var(--ink); }
  .qc-order { display: flex; align-items: center; gap: 6px; margin: 4px 0 2px; font: 0.8rem var(--mono); color: var(--muted); }
  .qc-order[hidden] { display: none; }
  .qc-order span { margin-right: 4px; letter-spacing: 0.04em; }
  .qc-order button {
    font: 600 0.82rem var(--sans); padding: 5px 12px; border-radius: 20px; cursor: pointer;
    border: 1px solid var(--line); background: transparent; color: var(--muted);
  }
  .qc-order button[aria-pressed='true'] { border-color: var(--cyan); color: var(--cyan); background: color-mix(in srgb, var(--cyan) 10%, transparent); }
  .qc-order button:hover { border-color: var(--cyan); }
  .qc-status { font-size: 1.02rem; min-height: 1.6em; margin: 10px 0; }
  .qc-status :global(strong) { color: var(--magenta); }
  .qc-actions { display: flex; flex-wrap: wrap; gap: 8px; min-height: 44px; }
  .qc-actions :global(button) {
    font: 600 0.93rem var(--sans); padding: 10px 16px; border-radius: 10px; cursor: pointer;
    border: 1.5px solid var(--line); background: var(--card); color: var(--ink);
  }
  .qc-actions :global(button:hover:not(:disabled)) { border-color: var(--cyan); color: var(--cyan); }
  .qc-actions :global(button.primary) { background: var(--grad); color: #fff; border-color: transparent; }
  .qc-actions :global(button.primary:hover:not(:disabled)) { color: #fff; filter: brightness(1.08); }
  .qc-actions :global(button.quantum) { border-color: var(--magenta); }
  .qc-actions :global(button:disabled) { opacity: 0.45; cursor: default; }
  .qc-actions :global(button .g) { font-family: var(--mono); font-weight: 700; margin-right: 4px; }
  .qc-actions :global(a) { align-self: center; font-size: 0.9rem; }
  .qc-score { margin-top: 12px; font: 0.8rem var(--mono); color: var(--muted); letter-spacing: 0.04em; }

  /* circuit: one wire, gate boxes, a meter */
  .qc-circuit { display: flex; align-items: center; gap: 0; margin: 12px 0 4px; min-height: 64px; overflow-x: auto; padding: 4px 2px 8px; }
  .qc-circuit:empty { display: none; }
  :global(.qc-wire-label) { font: 0.78rem var(--mono); color: var(--muted); margin-right: 6px; white-space: nowrap; }
  :global(.qc-seg) { flex: 0 0 18px; height: 2px; background: var(--muted); opacity: 0.6; }
  :global(.qc-gate) { position: relative; display: grid; place-items: center; flex: 0 0 auto; }
  :global(.qc-gate b) {
    display: grid; place-items: center; width: 38px; height: 38px; border-radius: 7px;
    font: 700 1rem var(--mono); border: 2px solid var(--muted); background: var(--card); color: var(--ink);
  }
  :global(.qc-gate.quantum b) { border-color: var(--magenta); color: var(--magenta); }
  :global(.qc-gate.classical b) { border-color: var(--cyan); color: var(--cyan); }
  :global(.qc-gate.secret b) { border-style: dashed; color: var(--muted); }
  :global(.qc-gate.empty b) { border-style: dotted; opacity: 0.45; }
  :global(.qc-gate.active b) { box-shadow: 0 0 0 4px color-mix(in srgb, var(--magenta) 25%, transparent); }
  :global(.qc-gate i) { position: absolute; top: 42px; font: normal 0.62rem var(--mono); color: var(--muted); white-space: nowrap; }
  :global(.qc-meter b) { border-color: var(--ink); font-size: 0.9rem; }

  .qc-hist { display: flex; gap: 10px; align-items: flex-end; height: 70px; margin-top: 8px; }
  .qc-noscript { color: var(--muted); }

  @media (prefers-reduced-motion: reduce) {
    .qc-box, .qc-prob .fill { transition: none; }
    .qcoin.shake .qc-box { animation: none; }
  }
  @media (max-width: 480px) {
    .qcoin { --coin: 150px; padding: 14px; }
    .qc-scene { height: 260px; }
    .qc-box { width: 200px; height: 186px; margin-left: -100px; }
  }
</style>
