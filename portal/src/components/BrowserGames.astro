---
/**
 * "Quantum games in your browser" strip linking the browser games to each other. Used only on the
 * unlisted preview pages for now (English); when the games launch, point the links at /play/….
 */
interface Props {
  current: 'coin' | 'ghz' | 'magic' | 'sat' | 'chsh' | 'hardy';
}
const { current } = Astro.props;
const GAMES = [
  { id: 'coin', href: '/preview/coin-game/', icon: '🪙', title: 'Quantum Coin Game', concept: 'Superposition & interference' },
  { id: 'ghz', href: '/preview/ghz-game/', icon: '🔗', title: 'GHZ Game', concept: 'Entanglement' },
  { id: 'chsh', href: '/preview/chsh-game/', icon: '🔔', title: 'CHSH Game', concept: 'Bell test' },
  { id: 'hardy', href: '/preview/hardys-paradox/', icon: '🌀', title: 'Hardy’s Paradox', concept: 'Nonlocality' },
  { id: 'magic', href: '/preview/magic-square/', icon: '🎩', title: 'Magic Square', concept: 'Contextuality' },
  { id: 'sat', href: '/preview/3sat-grover/', icon: '🧩', title: '3-SAT with Grover', concept: 'Grover’s search' },
] as const;
---

<nav class="games" aria-label="Quantum games in your browser">
  <h3>Quantum games, right in your browser</h3>
  <div class="grid cols-2">
    {GAMES.map((g) => (
      <a class="card" href={g.href} aria-current={g.id === current ? 'page' : undefined}>
        <span class="icon">{g.icon}</span>
        <h3>{g.title}</h3>
        <span class="meta">{g.concept}{g.id === current && ' · you are here'}</span>
      </a>
    ))}
  </div>
</nav>

<style>
  .games { margin: 8px 0 12px; }
  .games > h3 { margin: 0 0 14px; }
  .games a[aria-current='page'] { border-color: var(--magenta); }
  @media (min-width: 640px) { .games .grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1000px) { .games .grid { grid-template-columns: repeat(6, 1fr); } }
</style>
